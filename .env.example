# Development environment configuration.
# Copy to .env and adjust. Everything here has a working default in
# application.properties; this file only exists to make the knobs visible.

# S3-compatible object storage. Dev mode provisions the Floci emulator through Dev
# Services and wires the endpoint itself, so nothing here is needed to get started
# (ADR-44). The emulator is a throwaway — uploads do not survive a restart. To keep
# them, run any S3-compatible store and point dev at it; an explicit override always
# beats Dev Services.
# QUARKUS_S3_ENDPOINT_OVERRIDE=http://localhost:9000
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key-change-me
S3_BUCKET_FILES=files

# Port the dev reverse proxy publishes. :80 is the point — one origin, no port in the
# URL, same paths as production. Set this when :80 is already taken: the compose start
# is all-or-nothing, so a failed bind here stops dev mode from booting.
# DEV_PROXY_PORT=8000

# Keycloak. Dev Services provisions the realm from
# src/main/resources/realm_configuration-dev.json and the admin account below. The
# backend needs no client credentials of its own (ADR-45), so there are none here.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# HMAC secret for signed download tokens. Dev and test fall back to a fixed
# placeholder; %prod has no default and fails startup if it is missing.
DOWNLOAD_TOKEN_SECRET=dev-download-secret-CHANGE-ME
