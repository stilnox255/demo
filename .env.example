# Development environment configuration.
# Copy to .env and adjust. Everything here has a working default in
# application.properties; this file only exists to make the knobs visible.

# S3-compatible object storage. Dev mode starts the store from
# compose-devservices.yml and reaches it on localhost:9000 by default, so these only
# need setting to change the credentials or point somewhere else.
RUSTFS_ACCESS_KEY=dev-access-key
RUSTFS_SECRET_KEY=dev-secret-key-change-me
S3_ENDPOINT_OVERRIDE=http://localhost:9000
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key-change-me
S3_BUCKET_FILES=files

# Port the dev reverse proxy publishes. :80 is the point — one origin, no port in the
# URL, same paths as production. Set this when :80 is already taken: the compose start
# is all-or-nothing, so a failed bind here stops dev mode from booting.
# DEV_PROXY_PORT=8000

# Keycloak. Dev Services provisions a realm from
# src/main/resources/realm_configuration-dev.json; these values match it.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=backend
KEYCLOAK_CLIENT_SECRET=dev-secret-123

# HMAC secret for signed download tokens. Dev and test fall back to a fixed
# placeholder; %prod has no default and fails startup if it is missing.
DOWNLOAD_TOKEN_SECRET=dev-download-secret-CHANGE-ME
