# Copy to .env on the deployment host and fill in. Never commit the result.
#
# Everything the compose file needs from outside itself. Values that differ per
# environment live here; values that are the same everywhere are in the compose
# file, where they can be reviewed once.

# --- Domains -----------------------------------------------------------------
# The application answers at app.${DOMAIN}; Traefik routes it there.
DOMAIN=example.com
# Where Keycloak lives. Used for both the backend's OIDC issuer and the
# frontend's CSP connect-src, which is why it is a separate value.
AUTH_DOMAIN=auth.example.com
KEYCLOAK_REALM=starter

# --- Images ------------------------------------------------------------------
# Tags are what a deploy actually moves (ADR-38): CI builds an image once, tests
# it, and this stack pulls that exact tag. It never builds.
REGISTRY=registry.example.com
BACKEND_IMAGE_NAME=ingoschindler/starter-backend
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_NAME=ingoschindler/starter-frontend
FRONTEND_IMAGE_TAG=latest

# --- Observability -----------------------------------------------------------
# Where structured logs are shipped, over UDP syslog. The collector is a host-level
# prerequisite on monitoring_net and is NOT part of this stack — the monitoring profile
# below brings Prometheus and Grafana, not a log pipeline. With nothing listening the
# JSON stream is dropped silently; the plain-text console log is unaffected.
LOG_COLLECTOR_ENDPOINT=alloy:5140
LOG_LEVEL=INFO
